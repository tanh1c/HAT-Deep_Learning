\subsubsection{Approval request sequence}
\begin{figure}[H]
    \centering
    \includegraphics[width=0.8\textwidth]{graphics/chapter3/management/approval_requests.png}
    \caption{Sequence diagram of Approval Requests}
    \label{fig:search and book}
\end{figure}

\newpage
\noindent \textbf{Description} \\ 
\textbf{Actors:} Management, System, Database, Student, Tutor

\begin{enumerate}
    \item Student sends a request about scheduling, resources, or assignments to the System.
    \item Tutor sends a request about schedule changes or individual meetings to the System.
    \item System saves the request to the Database.
    \item System notifies Management of the new request.
    \item Management reviews the request and sends a decision to the System.
    \item The System handles the decision according to three alternative scenarios:
    \begin{enumerate}
        \item [a)] \textbf{Valid decision:}
        \begin{itemize}
            \item System updates the request status in the Database.
            \item System notifies both Student and Tutor of the decision.
        \end{itemize}
        \item [b)] \textbf{Request expired:}
        \begin{itemize}
            \item System logs an “Expired request” error.
            \item System sends a “Resubmit request” notification to both Student and Tutor.
        \end{itemize}
        \item [c)] \textbf{Invalid decision:}
        \begin{itemize}
            \item System logs an “Invalid decision” error.
            \item System requests Management to review again (re-approval).
        \end{itemize}
    \end{enumerate}
\end{enumerate}
